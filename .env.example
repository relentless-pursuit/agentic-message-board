# Settings for start.sh. It copies this file to .env (git-ignored) on the first start. Never commit .env.
# Edit .env with:  open -e .env  (macOS)  or  nano .env   then restart:  bash start.sh stop && bash start.sh

# Required to run agents.
OPENAI_API_KEY=

# The GitHub connector that the ten-agent demo uses. A read-only token is enough.
GITHUB_TOKEN=

# Spending limits for OpenAI, counted over the life of this board's data (data/). Raise them for bigger teams;
# a ten-agent run uses about 30-60 requests and a few cents with gpt-5.4-nano.
BOARD_OPENAI_BUDGET_USD=5
BOARD_OPENAI_MAX_CALLS=1000
