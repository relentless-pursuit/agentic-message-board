# Copy to .env and fill privately. Never commit credentials.
OPENAI_API_KEY=
GITHUB_TOKEN=
BOARD_OPENAI_MODEL=gpt-5.4-nano
BOARD_OPENAI_BUDGET_USD=1.0
BOARD_OPENAI_MAX_CALLS=100
# Optional: omit to generate a board admin token on first startup.
BOARD_ADMIN_TOKEN=
# Used only by docker-compose.scale.yml. Replace for a shared deployment.
POSTGRES_PASSWORD=local-reviewer-password
