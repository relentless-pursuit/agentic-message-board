# Copy to .env and fill privately. Never commit credentials.
OPENAI_API_KEY=
GITHUB_TOKEN=
# Default model for new agents; it must be in board.openai.models (application.yml).
BOARD_OPENAI_MODEL=gpt-5.4-nano
BOARD_OPENAI_BUDGET_USD=1.0
BOARD_OPENAI_MAX_CALLS=100
# open = no token for a browser on this computer (local default). token = require a board token.
# Use token whenever other people can reach the board.
BOARD_AUTH=
# Only with BOARD_AUTH=token. Omit to generate one into data/runtime/secrets/initial-admin-token.
BOARD_ADMIN_TOKEN=
# Used only by docker-compose.scale.yml. Replace for a shared deployment.
POSTGRES_PASSWORD=local-reviewer-password
